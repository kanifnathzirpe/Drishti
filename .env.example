# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration
DATABASE_URL="file:./data/drishti.db"

# Firebase / Cloud Storage Configuration (Simulated/Configurable)
FIREBASE_PROJECT_ID="drishti-mord-gov-in"
FIREBASE_CLIENT_EMAIL="drishti-service@drishti-mord-gov-in.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3\n-----END PRIVATE KEY-----\n"
STORAGE_BUCKET="drishti-land-records.appspot.com"

# Security & Authentication
JWT_SECRET="drishti-gov-in-secure-jwt-token-secret-key-2026"

# LRMS / DILRMP National Integration Gateway
LRMS_API_URL="https://dilrmp.nic.in/api/v2/records"
LRMS_API_KEY="mord_dilrmp_gateway_sandbox_key_9921"
